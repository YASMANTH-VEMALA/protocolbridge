{
  "name": "@protocolbridge/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "lint": "eslint src prisma/seed.ts --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.12"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  }
}
